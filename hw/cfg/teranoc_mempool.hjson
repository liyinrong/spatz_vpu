//
// TeraNoC integration config for the upstream Spatz VPU package render.
// Mirrors the vendored hardware/deps/spatz/cfg/spatz_pkg.hjson values. In the
// mempool branch N_FPU/N_IPU/VLEN/RVF/RVD are `ifdef-driven at vlog time (from
// TeraNoC config/*.mk knobs); the values below are the standalone fallbacks.
// spatz_nports/n_fpu fixes NumVLSUInterfaces=1 (TeraNoC spatz4 topology).
{
  spatz: {
    mempool: true,
    spatz_fpu: true,
    n_fpu: 4,
    n_ipu: 4,
    vlen: 512,
    spatz_nports: 4,
    double_bw: false,
    isa: "rv32imaf",
  }
}
